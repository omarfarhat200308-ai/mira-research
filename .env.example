# Anthropic API key — only required if MIRA_MOCK_LLM=0. Sonnet is primary
# for every stage, including dev/test — see README's cost-discipline note.
ANTHROPIC_API_KEY=

# 1 (default) = use deterministic MockLLMClient, no API calls, no key required
# 0 = call the real Claude Sonnet 5 API for every agent
MIRA_MOCK_LLM=1

# Groq API key — OPTIONAL, TRUE EMERGENCY FALLBACK ONLY (mira/llm_client.py).
# Only engages when the Anthropic call itself fails; every failover is
# logged, never silent. Leave unset to run Anthropic-only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Sarvam AI — Saaras (STT) / Bulbul (TTS), mira/speech/. Voice notes and
# voice replies raise SpeechServiceNotConfigured (fail loud, not silent)
# without this set.
SARVAM_API_KEY=

# Twilio credentials — needed to run mira.webhook against real WhatsApp
# (TwiML reply) AND, separately, for the Stage 5 doctor-handoff REST send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Stage 5: doctor handoff (mira/notifications/doctor_handoff.py) ---
# A real send additionally requires final_triage in {EMERGENCY,URGENT} AND
# data_source=pilot (see MIRA_DATA_SOURCE below) — this flag alone is not
# enough to trigger a send.
MIRA_ENABLE_DOCTOR_HANDOFF_SEND=0
TWILIO_WHATSAPP_FROM=
DOCTOR_WHATSAPP_NUMBER=

# --- Stage 6: consent/audit store (mira/consent/) ---
# Defaults to a local SQLite file if unset — point at real Postgres for the
# pilot. CONSENT_HASH_SALT's dev default is deliberately obviously insecure
# ("dev-only-insecure...") so it's visible in a config dump if still in use.
DATABASE_URL=
CONSENT_HASH_SALT=

# simulated (default) | pilot — mira/webhook.py reads this once per
# deploy, never inferred per-message. Gates real doctor-handoff sends and
# keeps simulated/pilot results from ever being blended in analysis.
MIRA_DATA_SOURCE=simulated

# Retry/timeout budget applied to every external call (Anthropic, Groq,
# Sarvam, Twilio REST) — see mira/reliability.py.
MIRA_EXTERNAL_CALL_MAX_RETRIES=2
MIRA_EXTERNAL_CALL_TIMEOUT_SECONDS=20
